/PROG DELAY
/ATTR
OWNER       = MNEDITOR;
COMMENT     = "Delay 3 seconds";
PROG_SIZE   = 500;
CREATE      = DATE 2026-10-29  TIME 10:00:00;
MODIFIED    = DATE 2026-10-29  TIME 10:00:00;
FILE_NAME   = "";
VERSION     = 0;
LINE_COUNT  = 10;
MEMORY_SIZE = 800;
PROTECT     = READ_WRITE;
STORAGE     = SHADOW;
TCD:  STACK_SIZE = 0,
      TASK_PRIORITY = 50,
      TIME_SLICE = 0,
      BUSY_LAMP_OFF = 0,
      ABORT_REQUEST = 0,
      PAUSE_REQUEST = 0;
DEFAULT_GROUP   = *,*,*,*,*;
CONTROL_CODE    = 00000000 00000000;
/APPL
/MN
   1:  DELAY 3.0 ;
/END